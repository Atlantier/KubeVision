# =============================================================================
# KubeVision AI — pnpm 安装策略
# 目标：彻底消除 Three.js / React Three Fiber / @huggingface/transformers 生态
#       在安装期的 Peer Dependency 警告或硬阻断，保证一次性冷启动成功。
# =============================================================================

# 自动安装缺失的 peer dependencies（pnpm v8+ 默认开启，此处显式固化以防全局配置覆盖）
auto-install-peers=true

# peer 版本不匹配时仅告警、不中断安装（R3F 8.x 对 react 的 peer 区间与 18.3.1 完全兼容，
# 但 drei / framer-motion 的传递依赖偶发声明 react ^18.0.0 之外的窄区间，必须放行）
strict-peer-dependencies=false

# 将 node_modules/.pnpm 内所有依赖提升到根 node_modules（等价于 hoist-pattern[]=*）。
# Next.js 14 的 webpack 解析与 Transformers.js 的可选原生依赖（sharp / onnxruntime-node）
# 探测逻辑依赖扁平化目录结构，提升后可避免 "Module not found" 类误报。
shamefully-hoist=true
