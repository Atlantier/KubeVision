# ==============================================================================
# KubeVision AI — 环境变量配置模板
# ==============================================================================
# 使用方法：复制本文件为 .env.local（Next.js 只自动加载 .env.local / .env）
#
#   cp .env.example .env.local
#
# ⚠️ 安全约定：.env.local 已被 .gitignore 忽略，绝不要提交真实密钥。
#    本文件中所有 Key 均为占位符（your-xxx-key-here），不可直接使用。
#
# 【双擎说明】本项目的 /api/chat 路由内置两套引擎，自动择优运行：
#   · 引擎 A（真实大模型）：配置了 OPENAI_API_KEY 且调用成功时启用；
#   · 引擎 B（确定性仿真器）：无 Key 或调用异常时**自动无缝接管**，
#     无需任何配置即可完整演示 Agent 思考链 + RAG 溯源 + 三张生成式 UI 卡片。
#
#   因此：**不填任何变量也能跑通全部演示**——这是刻意的离线优先设计，
#   保证在无网络、无额度、评审现场的脆弱 WiFi 下依旧可用。
# ==============================================================================


# ------------------------------------------------------------------------------
# 【必填项 · 引擎 A 启用开关】
# ------------------------------------------------------------------------------
# 兼容 OpenAI 协议的任意服务商都可用（智谱 / DeepSeek / 通义千问 / OpenAI 官方）。
# 留空则自动降级到引擎 B。
OPENAI_API_KEY=your-api-key-here

# 服务商 API 基址（必须包含 /v1，不要带尾部斜杠）
#   · 智谱 AI     → https://open.bigmodel.cn/api/paas/v4
#   · DeepSeek    → https://api.deepseek.com/v1
#   · 通义千问     → https://dashscope.aliyuncs.com/compatible-mode/v1
#   · OpenAI 官方  → https://api.openai.com/v1
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称（须与所选服务商的模型列表一致）
#   · 智谱 AI     → glm-4-flash（免费额度）/ glm-4-plus / glm-4v（多模态）
#   · DeepSeek    → deepseek-chat / deepseek-coder
#   · 通义千问     → qwen-plus / qwen-vl-plus（多模态）
#   · OpenAI 官方  → gpt-4o-mini / gpt-4o（多模态）
AI_MODEL_NAME=glm-4-flash


# ==============================================================================
# 【服务商配置示例 · 取消注释并填入 Key 即可切换】
# ==============================================================================

# ---- 方案 1：智谱 AI（推荐用于演示，glm-4-flash 有免费额度）--------------------
# 注册地址：https://open.bigmodel.cn  →  API Keys 页面创建
# 免费模型：glm-4-flash（速度快、中文强、额度充足，适合本项目的中文诊断报告）
# 多模态：  glm-4v / glm-4v-flash（支持图片输入，用于 3D 快照分析）
# OPENAI_API_KEY=your-zhipu-api-key-here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL_NAME=glm-4-flash

# ---- 方案 2：DeepSeek（推理能力突出，价格低廉）--------------------------------
# 注册地址：https://platform.deepseek.com  →  API Keys
# 注意：DeepSeek 的 base URL 需要带 /v1 后缀
# OPENAI_API_KEY=sk-your-deepseek-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL_NAME=deepseek-chat

# ---- 方案 3：通义千问 / 阿里云百炼（多模态首选）--------------------------------
# 注册地址：https://bailian.console.aliyun.com  →  API-KEY 管理
# 使用 compatible-mode 路径以兼容 OpenAI 协议
# 多模态模型 qwen-vl-plus 可直接接收 Base64 图片，用于 3D 视口快照分析
# OPENAI_API_KEY=sk-your-dashscope-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL_NAME=qwen-vl-plus

# ---- 方案 4：OpenAI 官方 ------------------------------------------------------
# 注册地址：https://platform.openai.com  →  API keys
# 注意：需确保账户有余额且网络可达
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini


# ==============================================================================
# 【可选配置】
# ==============================================================================

# 模型调用的最大重试次数（网络抖动时的容错，默认 2）
# AI_MAX_RETRIES=2

# 单次生成的温度（0 = 确定性最强，适合 SRE 诊断场景；默认 0.3）
# AI_TEMPERATURE=0.3

# 引擎 B 的打字机速率（字符/秒，调大可加快仿真报告输出，默认 60）
# SIM_TYPING_CPS=60


# ==============================================================================
# 【调试提示】
# ==============================================================================
# 1. 想强制走引擎 B（验证离线降级）？把 OPENAI_API_KEY 留空即可。
# 2. 想确认当前用的是哪个引擎？打开浏览器控制台看 /api/chat 的响应头
#    x-kubevision-engine: "llm"（引擎 A）或 "simulator"（引擎 B）。
# 3. 遇到 401 / 404？
#    · 401 → Key 无效或未生效（重启 dev server 让 .env.local 生效）
#    · 404 → OPENAI_BASE_URL 缺 /v1 或模型名拼写错误
# 4. 环境变量改动后必须重启 `pnpm dev`，Next.js 不会热重载 .env 文件。
