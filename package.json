{
  "name": "kubevision-ai",
  "version": "0.1.0",
  "private": true,
  "description": "KubeVision AI — Cloud-Native 3D Situational Awareness & Copilot",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:stream": "node scripts/verify-stream-integrity.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:demo-facts": "node scripts/verify-demo-facts.mjs",
    "verify:demo-matrix": "node scripts/verify-demo-matrix.mjs",
    "test:demo": "node scripts/run-demo-tests.mjs",
    "test:demo-cov": "node scripts/run-demo-tests.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "shot": "node scripts/shot.mjs",
    "probe:blackout": "node scripts/probe-blackout.mjs",
    "probe:r13": "node scripts/probe-r13.mjs",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "verify:parity": "node scripts/verify-mode-parity.mjs",
    "probe:health": "node scripts/probe-data-health.mjs",
    "probe:action-card": "node scripts/probe-action-card.mjs",
    "probe:edge-runtime": "node scripts/probe-edge-runtime.mjs",
    "verify:sanitizer": "node scripts/verify-sanitizer.mjs",
    "verify:mcp": "node scripts/verify-mcp-execute.mjs",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "verify:receipt": "node scripts/verify-receipt-digest.mjs",
    "probe:receipt": "node scripts/probe-receipt-verify.mjs",
    "probe:escape": "node scripts/probe-escape-stack.mjs",
    "probe:immune": "node scripts/probe-immune-reject.mjs",
    "verify:rag": "node scripts/verify-rag.mjs",
    "soak": "node scripts/soak.mjs",
    "strictmode:audit": "node scripts/strictmode-audit.mjs",
    "docs:metrics": "node scripts/sync-docs-metrics.mjs",
    "docs:evidence": "node scripts/capture-evidence.mjs",
    "benchmark:consistency": "node scripts/benchmark-consistency.mjs",
    "sim:drift": "node scripts/sim-drift.mjs",
    "verify:demo-drill": "node scripts/verify-demo-drill.mjs",
    "lint:glsl": "node scripts/lint-glsl.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "0.0.66",
    "@huggingface/transformers": "3.1.2",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "ai": "3.4.33",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "~0.169.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "~0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.3"
  }
}
