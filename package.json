{
  "name": "kubevision-ai",
  "version": "0.1.0",
  "private": true,
  "description": "KubeVision AI — Cloud-Native 3D Situational Awareness & Copilot",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "test:demo": "node scripts/run-demo-tests.mjs",
    "test:demo:fast": "node scripts/run-demo-tests.mjs --no-cov",
    "test:chat-stream": "node scripts/run-chat-stream-tests.mjs",
    "test:health": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test tests/clusterHealth.test.mjs",
    "test:keyboard": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test tests/keyboardTargets.test.mjs",
    "test:slots": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test tests/telemetrySlots.test.mjs",
    "test:chunk-retry": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test tests/chunkRetry.test.mjs",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "verify:parity": "node scripts/verify-mode-parity.mjs",
    "verify:sanitizer": "node scripts/verify-sanitizer.mjs",
    "verify:rag": "node scripts/verify-rag.mjs",
    "verify:receipt": "node scripts/verify-receipt-digest.mjs",
    "lint:glsl": "node scripts/lint-glsl.mjs",
    "check:dead-exports": "node scripts/check-dead-exports.mjs",
    "check:style-contract": "node scripts/check-style-contract.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "0.0.66",
    "@huggingface/transformers": "3.1.2",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "ai": "3.4.33",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.454.0",
    "next": "14.2.18",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1",
    "three": "0.169.0",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@11.8.0"
}
